# Dedicated Vozen Music application. Do not use TTS or Helper tokens.
DISCORD_TOKEN=
# Application ID from the dedicated Music application's General Information page.
DISCORD_APPLICATION_ID=
# Optional development server. Leave empty to register global commands and support all installed servers.
DISCORD_GUILD_ID=
# Optional HTTPS dashboard origin, without a trailing slash; enabling it requires the OAuth client secret.
MUSIC_DASHBOARD_ORIGIN=
DISCORD_CLIENT_SECRET=
# Internal HTTP listener. Publish through an HTTPS proxy, never directly to the internet.
MUSIC_HTTP_BIND=0.0.0.0:8790
